# Both the decomposition producer and this MCP server must use the same directory.
CC_EVAL_DATA_DIR=/absolute/path/to/cc_eval_data

# Keep false for public endpoints. Set true only for exact-allowlisted trusted
# internal HTTP gateways that do not provide HTTPS.
CC_EVAL_ALLOW_INSECURE_HTTP=false

# Judge gateway (required for feature_separate_eval_run)
CLAIM_DECOMPOSITION_JUDGE_API_URL=
CLAIM_DECOMPOSITION_JUDGE_ALLOWED_HOSTS=
CLAIM_DECOMPOSITION_JUDGE_API_TOKEN=
CLAIM_DECOMPOSITION_JUDGE_TOKEN_PREFIX=
CLAIM_DECOMPOSITION_JUDGE_MODEL=
CLAIM_DECOMPOSITION_JUDGE_TOKEN_HEADER=
CLAIM_DECOMPOSITION_JUDGE_TIMEOUT=
CLAIM_DECOMPOSITION_JUDGE_RETRIES=
CLAIM_DECOMPOSITION_JUDGE_MAX_TOKENS=

# PatSnap CLMS retrieval (base and allowlist required for patent records)
PATSNAP_API_BASE=
PATSNAP_ALLOWED_HOSTS=
# Optional when the trusted internal endpoint does not require a key.
PATSNAP_KEY=
